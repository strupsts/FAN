APP_ENV=local
DATABASE_URL=postgresql+psycopg://fan:fan_dev_password@localhost:5432/fan
RECEIPT_STORAGE_DIR=../storage/receipts
DEV_USER_ID=00000000-0000-4000-8000-000000000001

# Use "vlm" when the local receipt VLM server is running.
RECEIPT_EXTRACTION_PROVIDER=fake

VLM_BASE_URL=http://127.0.0.1:8002/v1
VLM_API_KEY=local-dev-key
VLM_MODEL=local-vlm-receipt-parser
VLM_TIMEOUT_SECONDS=120
VLM_TEMPERATURE=0
VLM_MAX_TOKENS=1200
